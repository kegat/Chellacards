{
  "rewrites": [
    { "source": "/success", "destination": "/index.html" },
    { "source": "/cancel", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html", "not": [{ "source": "/api/(.*)" }] }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}